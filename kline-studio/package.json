{
  "name": "kline-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "lint": "eslint . --max-warnings 0",
    "fetch:market": "node scripts/fetch-tradingview-market-snapshots.mjs",
    "import:replay": "node scripts/import-replay-layer.mjs",
