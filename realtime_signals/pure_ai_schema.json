{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "direction",
    "setup_type",
    "grade",
    "outer_state",
    "inner_state",
    "reasons",
    "confidence"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["A", "B", "OBSERVE", "NO_SIGNAL"]
    },
    "direction": {
      "type": "string",
      "enum": ["long", "short", "none"]
    },
    "setup_type": {
      "type": "string"
    },
    "grade": {
      "type": "string",
      "enum": ["A", "B", "none"]
    },
    "outer_state": {
      "type": "string"
    },
    "inner_state": {
      "type": "string"
    },
    "reasons": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
