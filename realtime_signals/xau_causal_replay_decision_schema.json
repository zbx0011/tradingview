{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "idx": { "type": "integer" },
    "bar_open_time": { "type": "integer" },
    "decision": { "type": "string", "enum": ["NO_SIGNAL", "OBSERVE", "SIGNAL"] },
    "direction": { "type": "string", "enum": ["none", "long", "short"] },
    "setup": { "type": "string" },
    "reason": { "type": "string" },
    "evidence_indices": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "max_used_idx": { "type": "integer" },
    "no_future_data": { "type": "boolean" }
  },
  "required": [
    "idx",
    "bar_open_time",
    "decision",
    "direction",
    "setup",
    "reason",
    "evidence_indices",
    "max_used_idx",
    "no_future_data"
  ]
}
